# Credentials and local environments. WRDS passwords belong in ~/.pgpass only.
.env
.env.*
!.env.example
.pgpass
*pgpass*
*credentials*
*.secret
.venv/
venv/

# Python, packaging, and notebook caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
build/
dist/
.DS_Store
.claude/memory/

# Generated results; retain the empty directory scaffold.
results/**
!results/**/
!results/**/.gitkeep

# The daily archive is tracked as three lossless LFS parts; ignore reassembly.
data/raw/crsp/daily_stocks_1961_2026q1.csv.gz
# Other data stages and any future TAQ extracts remain local.
data/raw/taq/
data/interim/crsp/
data/interim/taq/
data/processed/crsp/
data/processed/taq/
data/processed/replication/
# Pulls made through the WRDS API (licensed CRSP data) stay local.
data/raw/wrds_api/
# Public re-downloads (French library, Goyal-Welch); the LFS copies stay canonical.
data/raw/public/
